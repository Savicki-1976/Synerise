{
    "name": "savicki/synerise",
    "description": "Synerise API integration",
    "autoload": {
        "psr-4": {
            "Savicki\\Synerise\\": "src/"
        }
    },
    "require": {
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },

    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -l 5 src",
        "coverage": "XDEBUG_MODE=coverage  vendor/bin/phpunit --verbose --coverage-text",
        "coverage-html": "XDEBUG_MODE=coverage  vendor/bin/phpunit --coverage-html ./coverage/"
    }
}
